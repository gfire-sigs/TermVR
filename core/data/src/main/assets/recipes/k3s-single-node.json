{
  "schemaVersion": 1,
  "id": "k3s-single-node",
  "title": "Kubernetes Single-Node (k3s)",
  "summary": "Runs a single-node k3s Kubernetes control plane and kubelet on an ext4lite volume with optional Calico VXLAN networking.",
  "imageRef": "rancher/k3s:v1.32.2-k3s1",
  "minHostRamMiB": 0,
  "defaultProfileRamMiB": 0,
  "minFreeDiskMiB": 0,
  "volumeTemplateSuffix": "k3s",
  "volumeGuestMountPath": "/var/lib/rancher",
  "initDaemonArgv": [
    "/bin/sh",
    "-c",
    "mkdir -p /workspace/k3s && exec /bin/k3s \"$@\"",
    "sh",
    "server",
    "--flannel-backend=host-gw",
    "--disable=traefik,servicelb",
    "--write-kubeconfig=/workspace/k3s/kubeconfig.yaml",
    "--write-kubeconfig-mode=0644",
    "--tls-san=127.0.0.1",
    "--kubelet-arg=cgroups-per-qos=false",
    "--kubelet-arg=enforce-node-allocatable=",
    "--kubelet-arg=eviction-hard=memory.available<100Mi,nodefs.available<3%,imagefs.available<3%"
  ],
  "readinessTcpPort": 6443,
  "optionalAssetManifest": "recipes/calico-vxlan.yaml",
  "defaultAutoCheckpoint": false,
  "guestPrivileged": true,
  "makeRootRshared": true,
  "envVars": {
    "IPTABLES_MODE": "legacy",
    "KUBECONFIG": "/workspace/k3s/kubeconfig.yaml"
  },
  "defaultPortForwards": [
    {
      "id": "k3s-api",
      "protocol": "TCP",
      "listenHost": "LOOPBACK_V4",
      "hostPortStart": 6443,
      "hostPortEnd": 6443,
      "guestPortStart": 6443,
      "guestPortEnd": 6443,
      "enabled": true
    }
  ],
  "optionalVariantMinProfileRamMiB": null,
  "optionalVariantInitDaemonArgv": [
    "/bin/sh",
    "-c",
    "mkdir -p /workspace/k3s /var/lib/rancher/k3s/server/manifests && [ -f /workspace/calico-vxlan.yaml ] && cp -f /workspace/calico-vxlan.yaml /var/lib/rancher/k3s/server/manifests/calico-vxlan.yaml; exec /bin/k3s \"$@\"",
    "sh",
    "server",
    "--flannel-backend=none",
    "--disable-network-policy",
    "--cluster-cidr=10.42.0.0/16",
    "--disable=traefik,servicelb",
    "--write-kubeconfig=/workspace/k3s/kubeconfig.yaml",
    "--write-kubeconfig-mode=0644",
    "--tls-san=127.0.0.1",
    "--kubelet-arg=cgroups-per-qos=false",
    "--kubelet-arg=enforce-node-allocatable=",
    "--kubelet-arg=eviction-hard=memory.available<100Mi,nodefs.available<3%,imagefs.available<3%"
  ]
}
