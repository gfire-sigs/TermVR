{"repo": {"name": {"en-US": "TermVR Official F-Droid Repo"}, "description": {"en-US": "Official self-hosted F-Droid repository for TermVR, an unrooted Android 12+ Linux container runtime powered by gvx and libghostty-vt."}, "icon": {"en-US": {"name": "/icons/fdroid-icon.png", "sha256": "9fc6b1aed8943b1ffb9f26b90a815efa91d6b9c15aabf0dd98098d052a6b366c", "size": 11727}}, "address": "https://termvr.gfire.dev/fdroid/repo", "timestamp": 1795758646000, "categories": {"Development": {"name": {"en-US": "Development"}}, "System": {"name": {"en-US": "System"}}}}, "packages": {"dev.gfire.termvr": {"metadata": {"added": 1795758638000, "categories": ["Development", "System"], "changelog": "https://github.com/gfire-sigs/TermVR/blob/main/CHANGELOG.md", "issueTracker": "https://github.com/gfire-sigs/TermVR/issues", "lastUpdated": 1795758642000, "license": "Apache-2.0", "sourceCode": "https://github.com/gfire-sigs/TermVR", "webSite": "https://github.com/gfire-sigs/TermVR", "featureGraphic": {"en-US": {"name": "/dev.gfire.termvr/en-US/featureGraphic_nlrKAewYyHFUKzmRsCTc_zeDK9EPForablbxPmKiyi8=.png", "sha256": "9e5aca01ec18c871542b3991b024dcff37832bd10f168ada6e56f13e62a2ca2f", "size": 98907}}, "screenshots": {"phone": {"en-US": [{"name": "/dev.gfire.termvr/en-US/phoneScreenshots/1.png", "sha256": "b5108dc9435a64932e447d285058b4b71d0cae715cf872cdfa80fdfb2a18b131", "size": 207662}, {"name": "/dev.gfire.termvr/en-US/phoneScreenshots/2.png", "sha256": "f8e51738e53e74ea54cfeb48f66a1f4138d6e005bf2c015a01080f2e444491e4", "size": 318579}, {"name": "/dev.gfire.termvr/en-US/phoneScreenshots/3.png", "sha256": "bc09eb15868b590b0839ba4d0d1e5dd9c02c0c8bec3a1d239d9ab3e6a33c234e", "size": 211313}, {"name": "/dev.gfire.termvr/en-US/phoneScreenshots/4.png", "sha256": "7de2e074ff0b1f944bcae0bba392dad1dd03bf9739c3b5e1763bbcd00565edf7", "size": 226989}, {"name": "/dev.gfire.termvr/en-US/phoneScreenshots/5.png", "sha256": "9333f2f09575eaf63394f26a68fc3683e027cccdd67583cb4d124962e42c18d4", "size": 157783}, {"name": "/dev.gfire.termvr/en-US/phoneScreenshots/6.png", "sha256": "b3de1fa5f91cef1dfa159a04c47a5ffcf820d01b8cf210545f140e91e39df023", "size": 119167}]}}, "authorName": "gfire-sigs", "name": {"en-US": "TermVR"}, "summary": {"en-US": "Rootless Debian and OCI Linux containers with a 120 Hz GPU terminal"}, "description": {"en-US": "TermVR runs unmodified OCI Linux container images on Android 12 and newer without root privileges. It combines a user-space Linux runtime with an OpenGL ES 3.0 terminal emulator and mobile touch controls.\n\nCapabilities:\n- Debian 13 default with unlimited resources: Launch Debian 13 (debian:trixie-slim) with uncapped CPU and memory. Configure Ubuntu 24.04, Fedora 42, Alpine 3.21, or custom OCI images.\n- Concurrent multi-container sessions: Run multiple Linux containers side by side with multi-tab shells and one-tap Freeze and Resume.\n- Prebuilt container recipes: Start an unprivileged Docker Engine (docker:dind) or a single-node Kubernetes cluster (k3s) backed by persistent volumes.\n- 120 Hz GPU terminal and TermVR Mono NF: Render English, Korean Hangul, CJK scripts, OpenType ligatures, and Nerd Font icons at display refresh rates.\n- Mobile input controls: Configure a two-row auxiliary key bar with latched CTRL and ALT modifiers, cursor gestures, hardware shortcuts, and Hangul/CJK composition.\n- Explicit network and proxy control: Publish 127.0.0.1 or 0.0.0.0 ports with QR codes. Route traffic via HTTP, HTTPS, SOCKS5, SOCKS4, system proxies, or WireGuard.\n- Persistent volumes and file sharing: Create named ext4 volumes, transfer files through Storage Access Framework, and edit workspaces in external Android apps.\n- Offline open-source licenses and reproducible builds: TermVR compiles from pinned open-source commits with zero tracking SDKs and an offline license viewer.\n"}, "icon": {"en-US": {"name": "/dev.gfire.termvr/en-US/icon_RUqptNC8fTY8qJU1QpelCyMRyE9kY4IFUZP9EjAlgvY=.png", "sha256": "454aa9b4d0bc7d363ca895354297a50b2311c84f646382055193fd12302582f6", "size": 10832}}, "preferredSigner": "23faedb73343d4ae06dd849fcf803b39da420a11b32af8ef4ea1f63e1a5ac257"}, "versions": {"4590619b05a0c9fc3c9c0bff3829c679ea3fd00309b44e198917f2b63b0b46dd": {"added": 1795758639000, "file": {"name": "/TermVR-v0.27.10012026112300-arm64-v8a.apk", "sha256": "4590619b05a0c9fc3c9c0bff3829c679ea3fd00309b44e198917f2b63b0b46dd", "size": 24290338}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "0.27.10012026112300", "versionCode": 302700010, "usesSdk": {"minSdkVersion": 31, "targetSdkVersion": 36}, "signer": {"sha256": ["23faedb73343d4ae06dd849fcf803b39da420a11b32af8ef4ea1f63e1a5ac257"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "dev.gfire.termvr.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "cd86f9594f32c3a0304920f292e9b926a60438e092fb220e29a788be8cca900b": {"added": 1795758639000, "file": {"name": "/TermVR-v0.27.10002026112300-arm64-v8a.apk", "sha256": "cd86f9594f32c3a0304920f292e9b926a60438e092fb220e29a788be8cca900b", "size": 24286242}, "manifest": {"nativecode": ["arm64-v8a"], "versionName": "0.27.10002026112300", "versionCode": 302700000, "usesSdk": {"minSdkVersion": 31, "targetSdkVersion": 36}, "signer": {"sha256": ["23faedb73343d4ae06dd849fcf803b39da420a11b32af8ef4ea1f63e1a5ac257"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "dev.gfire.termvr.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}, "a0a2aa466850f20e250b7494744268dc586d5088f57a1d04